# Скопируйте в .env (рядом с manage.py) и впишите свои значения. Файл .env в git не попадает.
# База данных — только PostgreSQL (16+).

POSTGRES_DB=tildes
POSTGRES_USER=tildes
POSTGRES_PASSWORD=ваш_пароль
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Хосты, с которых Django принимает запросы (через запятую)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Для продакшена:
# DJANGO_SECRET_KEY=длинная-случайная-строка
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=tildes.kz,www.tildes.kz
# CSRF_TRUSTED_ORIGINS=https://tildes.kz,https://www.tildes.kz
