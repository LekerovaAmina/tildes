# Скопируйте в .env (рядом с manage.py) и впишите свои значения. Файл .env в git не попадает.
# Если POSTGRES_DB не задан — используется SQLite (db.sqlite3).

POSTGRES_DB=tildes
POSTGRES_USER=tildes
POSTGRES_PASSWORD=ваш_пароль
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Для продакшена:
# DJANGO_SECRET_KEY=длинная-случайная-строка
# DJANGO_DEBUG=0
