# Настройки для запуска в Docker (infra/docker-compose.yml).
# Скопируйте в .env (в корне репозитория) и при желании поменяйте значения:
#   Copy-Item .env.example .env
# Запуск с этим файлом:
#   docker compose --env-file .env -f infra/docker-compose.yml up --build
# Без .env compose возьмёт значения по умолчанию (tildes / tildes / tildes).
#
# Для запуска без Docker настройки лежат в backend/.env (см. backend/.env.example).

# --- PostgreSQL (сервис db; эти же значения получает Django в сервисе core) ---
POSTGRES_DB=tildes
POSTGRES_USER=tildes
POSTGRES_PASSWORD=tildes
